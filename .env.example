# Optional override when pointing at a Custom Connector / hosted API instead of the Vite mock.
# Absolute HTTPS hosts may use any domain (not limited to Microsoft primary domains).
VITE_DOCUMENT_API_BASE_URL=/api

# SharePoint publish target — vanity / custom domains supported (do not assume *.sharepoint.com).
VITE_SHAREPOINT_SITE_URL=https://docs.example.com/sites/Policies
VITE_SHAREPOINT_LIBRARY_NAME=Published Documents
VITE_SHAREPOINT_FOLDER_PATH=/Policies

# Dataverse org URL for adapters / docs — custom Dataverse domains supported.
VITE_DATAVERSE_ENVIRONMENT_URL=https://data.example.com

# --- Local DEV only (copy to .env.local; never used when hosted in Power Apps) ---
# Primary persona for `pnpm dev` standalone play + Admin access.
# VITE_LOCAL_DEMO_EMAIL=you@contoso.com
# VITE_LOCAL_DEMO_USER_NAME=Your Name
# Include admin to open #/admin. Tokens: user,author,approver,publisher,admin
# VITE_LOCAL_DEMO_ROLES=user,author,approver,publisher,admin
