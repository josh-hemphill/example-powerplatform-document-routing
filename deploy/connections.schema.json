{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://example.local/document-routing/connections.schema.json",
	"title": "Document Routing connection profile",
	"type": "object",
	"required": ["publisher", "solution", "powerPlatform", "dataverse", "sharePoint", "api"],
	"additionalProperties": false,
	"properties": {
		"$schema": { "type": "string" },
		"publisher": {
			"type": "object",
			"required": ["uniqueName", "friendlyName", "prefix"],
			"additionalProperties": false,
			"properties": {
				"uniqueName": { "type": "string", "minLength": 1 },
				"friendlyName": { "type": "string", "minLength": 1 },
				"prefix": {
					"type": "string",
					"pattern": "^[a-z]{2,8}$",
					"description": "Dataverse publisher prefix for custom tables/columns"
				},
				"optionValuePrefix": {
					"type": "integer",
					"minimum": 10000,
					"maximum": 99999,
					"description": "Publisher option-value prefix (e.g. 72700 → choice values 727000000+)"
				}
			}
		},
		"solution": {
			"type": "object",
			"required": ["uniqueName", "friendlyName", "version"],
			"additionalProperties": false,
			"properties": {
				"uniqueName": { "type": "string", "minLength": 1 },
				"friendlyName": { "type": "string", "minLength": 1 },
				"version": { "type": "string", "minLength": 1 }
			}
		},
		"powerPlatform": {
			"type": "object",
			"required": ["environmentId"],
			"additionalProperties": false,
			"properties": {
				"environmentId": { "type": "string", "minLength": 1 },
				"cloud": {
					"type": "string",
					"enum": ["public", "usgov", "usgovhigh", "usgovdod", "china"]
				}
			}
		},
		"dataverse": {
			"type": "object",
			"required": ["environmentUrl"],
			"additionalProperties": false,
			"properties": {
				"environmentUrl": {
					"type": "string",
					"minLength": 1,
					"description": "Any HTTPS org URL (custom/vanity Dataverse domains allowed)"
				},
				"apiVersion": { "type": "string", "default": "v9.2" }
			}
		},
		"sharePoint": {
			"type": "object",
			"required": ["siteUrl", "libraryName"],
			"additionalProperties": false,
			"properties": {
				"siteUrl": {
					"type": "string",
					"minLength": 1,
					"description": "Any HTTPS site URL (vanity SharePoint / custom domains allowed)"
				},
				"libraryName": { "type": "string", "minLength": 1 },
				"folderPath": { "type": "string" },
				"connectorId": {
					"type": "string",
					"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
					"default": "shared_sharepointonline"
				}
			}
		},
		"api": {
			"type": "object",
			"required": ["baseUrl"],
			"additionalProperties": false,
			"properties": {
				"baseUrl": {
					"type": "string",
					"minLength": 1,
					"description": "Document Routing OpenAPI host (Custom Connector / Function). Absolute HTTPS or /api for local mock."
				}
			}
		},
		"allowUnmanagedApply": {
			"type": "boolean",
			"description": "When true, allows pnpm provision:apply without --unmanaged-ok (scratch/dev only; avoid in shared orgs)"
		},
		"legacyDirectConnection": {
			"type": "boolean",
			"description": "When true, pa-connect.sh uses legacy connection-id wiring instead of connection-reference bind path"
		},
		"connectionReferences": {
			"type": "object",
			"additionalProperties": false,
			"description": "Optional overrides for generated SharePoint / Dataverse connection references",
			"properties": {
				"sharePoint": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"logicalName": { "type": "string", "minLength": 2 },
						"displayName": { "type": "string", "minLength": 1 },
						"connectorId": {
							"type": "string",
							"minLength": 1,
							"description": "Connector id token (e.g. shared_sharepointonline) or full /providers/.../apis/... id"
						}
					}
				},
				"dataverse": {
					"description": "Override Dataverse connection reference, or false to omit",
					"oneOf": [
						{ "type": "boolean", "const": false },
						{
							"type": "object",
							"additionalProperties": false,
							"properties": {
								"logicalName": { "type": "string", "minLength": 2 },
								"displayName": { "type": "string", "minLength": 1 },
								"connectorId": { "type": "string", "minLength": 1 }
							}
						}
					]
				}
			}
		},
		"notes": {
			"type": "array",
			"items": { "type": "string" }
		}
	}
}
