{
	"name": "example-powerplatform-document-routing",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.33.3",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"build": "pnpm generate:api && vue-tsc -b && vite build",
		"preview": "vite preview",
		"generate:api": "openapi-ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "vue-tsc -b --pretty false",
		"lint": "eslint .",
		"format": "eslint . --fix",
		"check": "pnpm lint && pnpm typecheck && pnpm test",
		"power:init": "pa app init --display-name \"Document Routing\"",
		"power:run": "pa app run",
		"power:push": "pnpm build && pa app push",
		"provision": "node --experimental-strip-types scripts/provision.ts",
		"provision:example": "node --experimental-strip-types scripts/provision.ts --example",
		"provision:apply": "node --experimental-strip-types scripts/provision.ts --apply"
	},
	"dependencies": {
		"@mdi/js": "^7.4.47",
		"@microsoft/power-apps": "^1.2.12",
		"@pinia/colada": "^1.4.2",
		"pinia": "^4.0.2",
		"vue": "^3.5.40",
		"vue-router": "^5.2.0",
		"vuetify": "^4.1.7"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.2.0",
		"@hey-api/openapi-ts": "^0.99.0",
		"@microsoft/power-apps-cli": "^0.15.2",
		"@microsoft/power-apps-vite": "^1.0.2",
		"@types/node": "^24.13.3",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vue/test-utils": "^2.4.11",
		"@vue/tsconfig": "^0.9.1",
		"ajv": "^8.20.0",
		"eslint": "^10.8.0",
		"eslint-plugin-format": "^2.0.1",
		"jsdom": "^30.0.1",
		"sass-embedded": "^1.100.0",
		"typescript": "~6.0.2",
		"vite": "^8.2.0",
		"vite-plugin-vuetify": "^2.1.3",
		"vitest": "^4.1.10",
		"vue-tsc": "^3.3.9"
	}
}
