{
	"name": "example-powerplatform-document-routing",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.0.0-rc.7",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"build": "pnpm generate:api && vue-tsc -b && vite build",
		"preview": "vite preview",
		"generate:api": "openapi-ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "vue-tsc -b --pretty false",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"check": "pnpm lint && pnpm typecheck && pnpm test:coverage",
		"check:bundle": "node scripts/check-bundle-budget.mjs",
		"power:init": "pa app init --display-name \"Document Routing\"",
		"power:run": "pa app run",
		"power:push": "pnpm build && pa app push",
		"provision": "node --experimental-strip-types scripts/provision.ts",
		"provision:example": "node --experimental-strip-types scripts/provision.ts --example",
		"provision:solution": "node --experimental-strip-types scripts/provision.ts --solution",
		"provision:apply": "node --experimental-strip-types scripts/provision.ts --apply",
		"provision:export": "node --experimental-strip-types scripts/provision-pack.ts export",
		"provision:pack": "node --experimental-strip-types scripts/provision-pack.ts pack",
		"provision:import": "node --experimental-strip-types scripts/provision-pack.ts import",
		"provision:validate": "node --experimental-strip-types scripts/validate-provision-artifacts.ts"
	},
	"dependencies": {
		"@mdi/js": "^7.4.47",
		"@microsoft/power-apps": "^1.2.12",
		"@pinia/colada": "^1.4.2",
		"dompurify": "^3.4.14",
		"marked": "^18.0.11",
		"pinia": "^4.0.2",
		"vue": "^3.5.40",
		"vue-router": "^5.2.0",
		"vuetify": "^4.1.7"
	},
	"devDependencies": {
		"@hey-api/openapi-ts": "^0.99.0",
		"@microsoft/power-apps-cli": "^0.15.2",
		"@microsoft/power-apps-vite": "^1.0.2",
		"@types/node": "^24.13.3",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vitest/coverage-v8": "4.1.10",
		"@vue/test-utils": "^2.4.11",
		"@vue/tsconfig": "^0.9.1",
		"ajv": "^8.20.0",
		"axe-core": "^4.13.0",
		"jsdom": "^30.0.1",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"sass-embedded": "^1.100.0",
		"typescript": "~6.0.2",
		"vite": "^8.2.0",
		"vite-plugin-vue-devtools": "^8.2.1",
		"vite-plugin-vuetify": "^2.1.3",
		"vitest": "^4.1.10",
		"vue-tsc": "^3.3.9"
	}
}
